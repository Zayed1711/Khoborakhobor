{
  "name": "khoborakhobor-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node -e \"require('fs').copyFileSync('prisma/dev.db', 'dev.db')\" && prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "cron": "node scripts/cron-worker.js",
    "scrape": "node scripts/scrape_real_news.js",
    "backup": "node scripts/backup_db.js",
    "backup:stats": "node scripts/backup_db.js --stats",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
