# KhoboraKhobor Environment Variables
DATABASE_URL="file:./prisma/database_placeholder.db"

# Required in production: signs the login session cookie. Use 32+ random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Without it, all logins are disabled in production.
SESSION_SECRET="replace_with_at_least_32_random_characters"

# Admin passcode login. Must be 12+ characters; passcode login is disabled if unset.
ADMIN_PASSCODE="your_admin_secret_passcode"

# Protects /api/cron/spider
CRON_SECRET="replace_with_random_cron_secret"

# Server watchdog alerts (scripts/ops/watchdog.sh). Create a bot with @BotFather,
# send it one message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Only on your computer, for scripts/ops/deploy.py
# DEPLOY_HOST="your.server.ip"
# GITHUB_TOKEN=""   # read-only token, needed only once the repository is private

# AI summary + fact card (Google Gemini, free tier). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# off (default) | shadow (runs and saves, shows nothing) | on
AI_FACTS=off
# Hard cap on AI calls per Dhaka day
AI_DAILY_CALLS=100
# Optional: models to try in order (cheap first)
# AI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
